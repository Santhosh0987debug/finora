# Placeholder only — no secrets belong in VITE_* variables; Vite embeds them
# in the browser bundle at build time.
# Copy to .env for local development:
#   Copy-Item .env.example .env   (PowerShell)
#   cp .env.example .env          (bash)
VITE_API_URL=http://localhost:4000
# Production (Vercel): set VITE_API_URL to the deployed Render backend URL,
# for example https://finora-api.onrender.com (no trailing slash), then rebuild.
